# ============================================================
# WangStore — Environment Variables
# Kelompok: APP / DATABASE / AUTH / EMAIL / CLOUD / WHATSAPP / DISCORD / SECURITY
# Salin file ini menjadi .env.local untuk pengembangan lokal.
# Jangan pernah meng-commit nilai secret (file .env dilarang masuk git).
# ============================================================

# ---------- APP ----------
# URL publik aplikasi. WAJIB diisi dengan domain production yang benar saat deploy.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=WangStore

# ---------- DATABASE ----------
# PostgreSQL cloud/serverless (contoh: Supabase, Neon, Vercel Postgres, Railway).
# Jika DATABASE_URL TIDAK diisi dan NODE_ENV=development, aplikasi memakai
# JSON datastore lokal (data/*.json) sebagai fallback DEVELOPMENT SAJA.
# Production/Preview TANPA DATABASE_URL akan gagal secara eksplisit.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# ---------- AUTH ----------
# Secret acak untuk menandatangani token verifikasi/reset (jose JWT).
# Generate: openssl rand -base64 48
AUTH_SECRET=please-change-me-to-a-long-random-secret

# ---------- EMAIL (SMTP) ----------
# SMTP dipakai untuk: Email Verification & Forgot/Reset Password.
# Jika SMTP belum dikonfigurasi, email tidak akan terkirim (status ditampilkan jujur).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@wangstore.example
SMTP_FROM_NAME=WangStore

# ---------- CLOUD / BOT PROTECTION ----------
# Cloudflare Turnstile (opsional). Kosongkan jika belum dipakai.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- WHATSAPP ----------
# Nomor WhatsApp bisnis (format internasional tanpa '+', contoh: 6281234567890).
# Dipakai untuk URL wa.me pada alur pemesanan. Dapat juga diubah via Admin Panel.
WHATSAPP_NUMBER=

# ---------- DISCORD ----------
# Undangan server Discord komunitas (opsional).
DISCORD_URL=

# ---------- SECURITY ----------
# Secret untuk endpoint cron (Vercel Cron). Wajib berbeda dari AUTH_SECRET.
CRON_SECRET=
